# tg-ws-proxy — конфигурация запуска.
#
# Скопируйте шаблон:  cp .env.example .env   (или: make env)
# Файл .env не попадает ни в git, ни в образ.

# --- Прокси ---
# Секрет MTProto (ровно 32 hex-символа).
# Пусто -> секрет создаётся в .secret и сохраняется между перезапусками
# и перезагрузками. Не удаляйте .secret, иначе изменится ссылка tg://proxy.
TG_WS_PROXY_SECRET=

# Адрес и порт прослушивания
TG_WS_PROXY_HOST=0.0.0.0
TG_WS_PROXY_PORT=1443

# --- Docker ---
# bridge — изолированная сеть, порт публикуется через -p (по умолчанию)
# host   — общая сеть с хостом, публиковать порт не нужно
TG_WS_PROXY_NETWORK=bridge

# DNS внутри контейнера (для host-сети с systemd-resolved обычно 127.0.0.53).
# Пусто -> не переопределять (правильно для bridge).
TG_WS_PROXY_DNS=

# Имена образа и контейнера
IMAGE=tg-ws-proxy
CONTAINER=tg-ws-proxy

# --- Обход блокировки ---
# Домен своего Cloudflare Worker (docs/RU/CfWorker.md). Пусто -> не используется.
TG_WS_PROXY_CF_WORKER=

# Прямые DC -> IP:
#   (пусто)              — дефолт образа: 2:149.154.167.220 4:149.154.167.220
#   none                 — без прямых IP, только пул CF Worker
#   2:1.2.3.4 4:5.6.7.8  — явный список
TG_WS_PROXY_DC_IPS=

# Доп. аргументы прокси (через пробел):
#   --no-cfproxy — не использовать авто-домены Cloudflare
#   --no-h2      — отключить H2-мультиплексирование медиа
#   --no-secure  — порт 80 для Cloudflare
EXTRA_ARGS=
